rules_version = '2';
// ══════════════════════════════════════════════════════════════════════
// FASE 1 — Reglas con roles (reemplaza la regla única "cualquier
// autenticado puede todo"). El rol de cada usuario vive en su documento
// /usuarios/{uid}; estas reglas lo consultan con get()/exists() en cada
// evaluación, siguiendo el patrón oficial de Firebase para control de
// acceso basado en roles (no requiere Cloud Functions ni custom claims).
// ══════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {
    function estaAutenticado() {
      return request.auth != null;
    }
    function existeUsuario() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function usuarioActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function estaActivo() {
      return existeUsuario() && usuarioActual().activo == true;
    }
    function tieneRol(roles) {
      return estaAutenticado() && existeUsuario() && estaActivo() && usuarioActual().rol in roles;
    }
    function esAdmin()            { return tieneRol(['ADMINISTRADOR']); }
    function esEncargado()        { return tieneRol(['ADMINISTRADOR','ENCARGADO_MANTENIMIENTO']); }
    function esSupervisorOMas()   { return tieneRol(['ADMINISTRADOR','ENCARGADO_MANTENIMIENTO','SUPERVISOR']); }
    function esTecnicoOMas()      { return tieneRol(['ADMINISTRADOR','ENCARGADO_MANTENIMIENTO','SUPERVISOR','TECNICO']); }
    function esAlmacenOMas()      { return tieneRol(['ADMINISTRADOR','ENCARGADO_MANTENIMIENTO','ALMACEN']); }
    // Rol Operador (29 sep 2026): cualquier trabajador de planta, NO solo
    // técnicos, necesita poder reportar una falla desde su celular sin
    // pasar por el flujo completo de Bitácora — igual que la diferencia
    // Maximo/SAP entre "notificación" (cualquiera) y "orden de trabajo"
    // (planificador/técnico). Operador es el rol MÁS restringido de todos:
    // solo puede leer /equipos (para elegir cuál falló) y crear una OT
    // "pendiente" con datos mínimos — no puede leer la cola de OTs, ni
    // checklists, ni análisis, ni nada más.
    function esOperadorOMas() { return tieneRol(['ADMINISTRADOR','ENCARGADO_MANTENIMIENTO','SUPERVISOR','TECNICO','OPERADOR']); }
    function esOperador()     { return tieneRol(['OPERADOR']); }
    // Herramientas por técnico (2 oct 2026): rol RRHH (Recursos Humanos) solo
    // ve los cargos por herramientas y marca si se descontaron.
    function esRRHH()         { return tieneRol(['RRHH']); }
    function esTecnico()      { return tieneRol(['TECNICO']); }
    // Nombre de técnico del usuario: campo "tecnico" de /usuarios o, si no
    // existe, su "nombre". Debe ser igual al nombre usado en las OTs.
    function miTecnico()      { return usuarioActual().get('tecnico', usuarioActual().get('nombre', '')); }
    function soloCambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    match /usuarios/{uid} {
      allow read: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }
    // CORRECCIÓN (revisión previa a publicar): /config/app guarda el PIN
    // compartido para borrar repuestos/equipos en Inventario. No tenía
    // regla propia — con las reglas por rol activas habría quedado
    // bloqueado por defecto y nadie habría podido verificar el PIN.
    match /config/{id} { allow read: if esTecnicoOMas() || esAlmacenOMas(); allow write: if esAdmin(); }
    // Módulo de Checklists (17 sep 2026): /config/otFolioCounter guarda el
    // número correlativo del folio de la próxima OT generada desde un
    // checklist (OT-0001, OT-0002...). A diferencia de /config/app (el PIN),
    // cualquier técnico necesita poder incrementarlo al reportar una falla
    // en su checklist — esta coincidencia de ruta con /config/{id} de arriba
    // es intencional: Firestore permite ambas reglas y usa la más permisiva
    // solo para este documento puntual; /config/app sigue protegido igual
    // que antes.
    // Operador también necesita generar folio (OT-0001...) al reportar una
    // falla — mismo contador que usan Checklist y Bitácora.
    match /config/otFolioCounter { allow read, write: if esOperadorOMas(); }
    // /checklists: el técnico llena y guarda el checklist de un equipo
    // (create); solo Encargado/Admin puede corregir uno ya guardado
    // (update), y borrarlo queda reservado a Admin, igual que el resto.
    match /checklists/{id} {
      allow read: if esTecnicoOMas();
      allow create: if esTecnicoOMas();
      allow update: if esEncargado();
      allow delete: if esAdmin();
    }
    match /plantas/{id} { allow read: if esTecnicoOMas(); allow write: if esAdmin(); }
    match /areas/{id}   { allow read: if esTecnicoOMas() || esAlmacenOMas(); allow write: if esEncargado(); }
    match /lineas/{id}  { allow read: if esTecnicoOMas(); allow write: if esEncargado(); }
    // CORRECCIÓN (revisión previa a publicar): en la app actual, los
    // repuestos de cada equipo se guardan como un array dentro del propio
    // documento de /equipos/{id} (no en una colección aparte), y son los
    // técnicos —no solo Encargado/Admin— quienes cargan/editan repuestos
    // desde el celular a diario. Restringir "update" a esEncargado()
    // les habría bloqueado esa función a partir de hoy. Se deja en
    // esTecnicoOMas() para no romper el uso diario; borrar el equipo
    // completo sigue reservado a esAdmin().
    match /equipos/{id} {
      // Operador necesita ver la lista de equipos para elegir cuál falló
      // (solo lectura — crear/editar/borrar equipos sigue igual que antes).
      // (4 oct 2026) Almacén también administra el inventario de repuestos:
      // antes no podía ni ver los equipos.
      allow read: if esOperadorOMas() || esAlmacenOMas();
      allow create, update: if esTecnicoOMas() || esAlmacenOMas();
      allow delete: if esAdmin();
    }
    function esReporteQR() {
      let d = request.resource.data;
      return d.origen == 'qr' && d.estado == 'pendiente' &&
        d.keys().hasOnly(['origen','estado','folio','equipoId','equipoNombre','equipoLocalidad',
          'descripcionFalla','prioridad','creadoPor','creadoPorUid','maquinaParada','fechaReporte',
          'horaParada','checklistId','asignadoA','fechaPlanificada','createdAt']) &&
        d.equipoId is string && exists(/databases/$(database)/documents/equipos/$(d.equipoId)) &&
        d.descripcionFalla is string && d.descripcionFalla.size() > 0 && d.descripcionFalla.size() <= 1000 &&
        d.creadoPor is string && d.creadoPor.size() > 0 && d.creadoPor.size() <= 100 &&
        d.prioridad in ['alta','media','baja'] && d.asignadoA == null && d.createdAt == request.time;
    }
    match /ots/{id} {
      // Operador NO puede leer la cola de OTs (esTecnicoOMas() se queda
      // igual) — solo crear una nueva, y solo con forma restringida: sin
      // técnico ni tiempo trabajado (eso lo llena Encargado/Técnico al
      // planificarla), estado fijo en "pendiente" y origen "operador" para
      // distinguirla en el historial.
      // (1 oct 2026) Producción (Operador) puede LEER los reportes de
      // operador para ver en vivo si su parada está esperando técnico, en
      // atención o resuelta. Solo esos: la consulta de reportar.html filtra
      // where('origen','==','operador'), que es lo que esta regla exige.
      allow read: if esTecnicoOMas() || (esOperador() && resource.data.origen == 'operador');
      // (4 oct 2026) QR público (equipo.html): cualquiera que escanee la
      // etiqueta de una máquina —con o sin usuario— puede dejar un reporte,
      // pero SOLO con esta forma: origen "qr", estado "pendiente", sin
      // técnico ni tiempos, campos limitados y un equipo que exista de verdad.
      allow create: if esReporteQR() || esTecnicoOMas() || (esOperador() &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.origen == 'operador' &&
        !('TECNICOS' in request.resource.data) &&
        !('TOTAL_MIN_TECNICO' in request.resource.data));
      // (29 sep 2026: "esSupervisorOMas() || esTecnicoOMas()" era lógica
      // muerta — esTecnicoOMas() ya incluye a Supervisor y a todos los
      // roles de arriba, así que el || nunca cambiaba el resultado.
      // Simplificado sin cambiar a quién permite: sigue siendo cualquiera
      // de Técnico para arriba.)
      allow update: if esTecnicoOMas();
      allow delete: if esAdmin();
    }
    // (4 oct 2026) Copia pública de cada equipo para el QR: ficha técnica e
    // historial resumido (sin técnicos, costos ni repuestos). Se lee de a uno
    // sin sesión (nunca la lista completa); la escribe el personal desde la app.
    match /equipos_publico/{id} {
      allow get: if true;
      allow list, write: if esTecnicoOMas() || esAlmacenOMas();
    }
    match /movimientos/{id} {
      allow read: if esTecnicoOMas() || esAlmacenOMas();
      allow create: if esAlmacenOMas() || esTecnicoOMas();
      allow update, delete: if esAdmin();
    }
    // Reubicación de equipo entre áreas (29 sep 2026): cada vez que cambia
    // la Localidad de un equipo en Inventario se agrega un renglón nuevo
    // aquí (nunca se sobrescribe ni se borra) — mismo criterio que
    // "movimientos" arriba, pero para dónde está instalado el equipo en
    // vez de su stock de repuestos.
    match /reubicaciones/{id} {
      allow read: if esTecnicoOMas();
      allow create: if esTecnicoOMas();
      allow update, delete: if esAdmin();
    }
    match /repuestos/{id}          { allow read: if esTecnicoOMas(); allow write: if esAlmacenOMas(); }
    match /planes_preventivos/{id} { allow read: if esTecnicoOMas(); allow write: if esEncargado(); }
    match /solicitudes_compra/{id} { allow read: if esAlmacenOMas(); allow write: if esAlmacenOMas() || esEncargado(); }
    match /proveedores/{id}        { allow read: if esAlmacenOMas(); allow write: if esEncargado(); }
    // Auditoría de cambios en datos maestros (29 sep 2026): ANTES esta regla
    // bloqueaba TODA escritura ("allow write: if false"), así que la
    // colección nunca se pudo usar — no hay backend/Cloud Functions en este
    // proyecto que pudiera saltarse esa regla y escribir por su cuenta.
    // Ahora permite crear (nunca editar ni borrar, para que el rastro sea
    // confiable) a cualquier técnico o más — igual que /equipos y /checklists,
    // las únicas colecciones que en verdad generan estos registros desde
    // inventario.html y checklist.html.
    match /auditoria/{id} {
      allow read: if esEncargado();
      allow create: if esTecnicoOMas();
      allow update, delete: if false;
    }
    // ══════ HERRAMIENTAS POR TÉCNICO (2 oct 2026) ══════
    // Gestionan (entregan, reciben, hacen arqueo): Administrador, Encargado y
    // Almacén. Supervisor solo consulta. El técnico solo ve lo suyo y solo
    // puede confirmar que recibió una entrega y dar su conformidad en un
    // arqueo. RRHH solo cambia el estado del cargo. Los arqueos y el registro
    // de movimientos nunca se borran (respaldan los descuentos).
    match /herramientas/{id} {
      allow read: if esTecnicoOMas() || esAlmacenOMas() || esRRHH();
      allow create, update: if esAlmacenOMas();
      allow delete: if esAdmin();
    }
    match /herramientas_asignadas/{id} {
      allow read: if esAlmacenOMas() || esSupervisorOMas() || esRRHH()
        || (esTecnico() && resource.data.tecnico == miTecnico());
      allow create: if esAlmacenOMas();
      allow update: if esAlmacenOMas()
        || (esTecnico() && resource.data.tecnico == miTecnico()
            && soloCambia(['aceptada', 'aceptadaEn', 'aceptadaPor'])
            && request.resource.data.aceptada == true);
      allow delete: if esAdmin();
    }
    match /herramientas_arqueos/{id} {
      allow read: if esAlmacenOMas() || esSupervisorOMas() || esRRHH()
        || (esTecnico() && resource.data.tecnico == miTecnico());
      allow create: if esAlmacenOMas();
      allow update: if esAdmin()
        || ((esAlmacenOMas() || esRRHH()) && soloCambia(['rrhh']))
        || (esTecnico() && resource.data.tecnico == miTecnico() && soloCambia(['conformidad'])
            && resource.data.conformidad.estado == 'pendiente');
      allow delete: if false;
    }
    match /herramientas_movimientos/{id} {
      allow read: if esAlmacenOMas() || esSupervisorOMas() || esRRHH();
      allow create: if esAlmacenOMas();
      allow update, delete: if false;
    }
  }
}
